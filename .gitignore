.DS_Store

# local settings of the coding assistant
/.claude/

# local configuration and data
/config.php
/data/
/torrents/*.torrent
/logs/
/tmp/
/update.zip

# release archives built by tools/release.sh
/dist/

# test environment secrets and recordings
/tests/env/secrets/*
!/tests/env/secrets/*.example

# pinned versions of the outside services of the test stack
/tests/env/versions.env
