# Корень сайта должен указывать на каталог public. Если веб-сервер (Apache) настроен
# на этот каталог, запросы передаются в public, а остальные файлы остаются закрытыми.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
