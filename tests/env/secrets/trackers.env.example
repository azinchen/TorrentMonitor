# Copy to trackers.env (same folder) and fill in. trackers.env is ignored by git.
#
# Live tests (tests/run.sh live) test every tracker that has an account here; a tracker
# with an empty login is skipped. rutor.is, tfile.cc and lostfilm-mirror need no account
# and are always tested (set <NAME>_SKIP=1 to leave one out).
#
# What to watch is chosen automatically: a fresh topic from the tracker's listing page,
# or the newest series of its feed. Optional keys, for any tracker:
#   <NAME>_TOPIC=       fix the topic (its address or id) or, for series trackers, the series name
#   <NAME>_QUALITY=     series trackers: sd, 720 or 1080
#   <NAME>_WATCH_USER=  a user of the tracker whose topics must be found (watching users)
#   <NAME>_COOKIE=      session cookie from a browser, if the tracker asks for a captcha
#   <NAME>_ADDRESS=     another address (mirror) of the tracker
#   <NAME>_SKIP=1       do not test this tracker

RUTRACKER_LOGIN=
RUTRACKER_PASSWORD=

# kinozal.me, kinozal.tv or kinozal.guru (one account works on all of them)
KINOZAL_DOMAIN=kinozal.me
KINOZAL_LOGIN=
KINOZAL_PASSWORD=

NNMCLUB_LOGIN=
NNMCLUB_PASSWORD=

PORNOLAB_LOGIN=
PORNOLAB_PASSWORD=

RUSTORKA_LOGIN=
RUSTORKA_PASSWORD=

BOOKTRACKER_LOGIN=
BOOKTRACKER_PASSWORD=

ANIDUB_LOGIN=
ANIDUB_PASSWORD=

ANIMELAYER_LOGIN=
ANIMELAYER_PASSWORD=

RIPERAM_LOGIN=
RIPERAM_PASSWORD=

# lostfilm.tv: the login is the e-mail address
LOSTFILM_LOGIN=
LOSTFILM_PASSWORD=

NEWSTUDIO_LOGIN=
NEWSTUDIO_PASSWORD=

# baibako.tv: one account for the series feed and the forum; the passkey is in the RSS link
# of the profile. The forum has its own optional keys: BAIBAKO_FORUM_TOPIC, BAIBAKO_FORUM_SKIP
BAIBAKO_LOGIN=
BAIBAKO_PASSWORD=
BAIBAKO_PASSKEY=

# no account needed
RUTOR_SKIP=
TFILE_SKIP=
LOSTFILM_MIRROR_SKIP=
