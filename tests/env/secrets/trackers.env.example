# Copy to trackers.env (same folder) and fill in. trackers.env is ignored by git.
# A tracker with an empty login is skipped by live tests.
# *_TOPIC is the number of any topic you may download: t=<number> on rutracker,
# id=<number> on kinozal.

RUTRACKER_LOGIN=
RUTRACKER_PASSWORD=
RUTRACKER_TOPIC=

# kinozal.me, kinozal.tv or kinozal.guru
KINOZAL_DOMAIN=kinozal.me
KINOZAL_LOGIN=
KINOZAL_PASSWORD=
KINOZAL_TOPIC=
