# Copy to services.env (same folder) and fill in. services.env is ignored by git.
# Live tests (tests/run.sh live) test every service that is filled in here; the rest are skipped.
# Deluge, TorrServer, Gotify and e-mail need nothing here: they are tested locally by
# tests/run.sh integration.

# ---- notification services: each one gets one test message
# Telegram: bot token and chat id (a chat id may be followed by :topic)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT=
# Pushover: user key and application token
PUSHOVER_USER=
PUSHOVER_TOKEN=
# Pushbullet: access token
PUSHBULLET_TOKEN=
# Prowl: API key
PROWL_KEY=
# Pushall: id and key
PUSHALL_ID=
PUSHALL_KEY=
# a Gotify server of your own (the local one is tested without this): address and application token
GOTIFY_ADDRESS=
GOTIFY_TOKEN=

# ---- Synology Download Station (cannot run in Docker, so only a real NAS can be tested)
# address like http://192.168.1.10:5000; the test adds one torrent by link and removes it at once
SYNOLOGY_ADDRESS=
SYNOLOGY_LOGIN=
SYNOLOGY_PASSWORD=
# shared folder for downloads, e.g. downloads (empty - the default of Download Station)
SYNOLOGY_PATH=
# link to any .torrent file the NAS can fetch (empty - the current Debian netinst image)
SYNOLOGY_TORRENT_URL=
