# Versions (image tags) of the outside services of the test stack.
# Copy to versions.env to pin them for every run, or set a variable for one run:
#   TM_QBITTORRENT_VERSION=4.6.7 tests/run.sh integration
# A variable of the shell wins over this file. Without either, the newest image is used.
# Tags: https://github.com/orgs/linuxserver/packages (or the "Tags" page of the image).

# linuxserver.io images
TM_QBITTORRENT_VERSION=latest
TM_TRANSMISSION_VERSION=latest
TM_DELUGE_VERSION=latest
TM_SONARR_VERSION=latest
TM_MARIADB_VERSION=latest

# linuxserver.io has no image of these
TM_TORRSERVER_VERSION=latest
TM_GOTIFY_VERSION=latest
TM_POSTGRES_VERSION=latest
TM_BYPARR_VERSION=latest
TM_FLARESOLVERR_VERSION=latest
TM_VPN_VERSION=latest
