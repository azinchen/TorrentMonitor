#!/usr/bin/env bash
# Blocks a push that would publish anything from tests/env/secrets:
#  - a secrets file itself (anything there except *.example);
#  - any value from those files appearing in the pushed changes.
# Installed by: tests/run.sh hooks
root=$(git rev-parse --show-toplevel)
secrets_dir="$root/tests/env/secrets"
zero=0000000000000000000000000000000000000000

values=()
for file in "$secrets_dir"/*.env; do
    [[ -f "$file" ]] || continue
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*[A-Za-z0-9_]+=(.*)$ ]] || continue
        value="${BASH_REMATCH[1]}"
        value="${value%$'\r'}"
        # short values (domains aside) would match ordinary text
        [[ ${#value} -ge 6 && "$value" != kinozal.* ]] && values+=("$value")
    done < "$file"
done

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue
    if [[ "$remote_sha" == "$zero" ]]; then
        range=$(git rev-list "$local_sha" --not --remotes | tr '\n' ' ')
    else
        range=$(git rev-list "$remote_sha..$local_sha" | tr '\n' ' ')
    fi
    [[ -z "$range" ]] && continue

    tracked=$(git log --format= --name-only $range -- tests/env/secrets | sort -u | grep -v '\.example$' || true)
    if [[ -n "$tracked" ]]; then
        echo "pre-push: secrets files are part of this push:" >&2
        echo "$tracked" | sed 's/^/  /' >&2
        status=1
    fi

    for value in "${values[@]}"; do
        commit=$(git log --format=%h -S"$value" $range | head -1)
        if [[ -n "$commit" ]]; then
            echo "pre-push: a value from tests/env/secrets appears in commit $commit (value not shown)" >&2
            status=1
        fi
    done
done

[[ $status -eq 0 ]] || echo "pre-push: push blocked. Remove the secret from the commits and try again." >&2
exit $status
