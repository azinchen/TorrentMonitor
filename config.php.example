<?php
// Необязательный файл. TorrentMonitor работает и без него: все настройки, учётные
// данные и темы хранятся в каталоге данных (по умолчанию data/ рядом с программой).
// Скопируйте файл как config.php, только если нужна одна из настроек ниже.

# Каталог данных (настройки, пароли, темы). По умолчанию data/ рядом с программой.
# То же самое можно задать переменной окружения TM_DATA_DIR.
#Config::write('data.dir', '/var/lib/torrentmonitor');

# Путь к CLI-интерпретатору PHP для POST /api/run.
# Нужен, если интерпретатор не находится автоматически: нестандартная сборка,
# open_basedir, несколько версий PHP на сервере.
#Config::write('php.cli', '/usr/bin/php8.3');

# Сколько трекеров опрашивать одновременно (по умолчанию 10).
#Config::write('curl.concurrency', 5);

# Каталог для скачанных torrent-файлов (по умолчанию torrents/ рядом с программой).
#Config::write('torrents.dir', '/var/lib/torrentmonitor/torrents');

# Адрес, по которому перед опросом трекеров проверяется подключение к интернету.
# Пустая строка отключает проверку.
#Config::write('connectivity.url', 'https://example.org/');
