// Optional file. TorrentMonitor works without it: all settings, accounts and topics are kept
// in the data directory (data/ next to the program by default).
// Copy this file to config.php only if you need one of the settings below.

// Data directory (settings, passwords, topics). Default: data/ next to the program.
// The TM_DATA_DIR environment variable does the same.
//Config::write('data.dir', '/var/lib/torrentmonitor');

// Directory for downloaded torrent files (default: torrents/ next to the program).
//Config::write('torrents.dir', '/var/lib/torrentmonitor/torrents');

// Path to the PHP CLI binary, used to start a check in the background.
// Needed when it is not found automatically: custom build, open_basedir, several PHP versions.
//Config::write('php.cli', '/usr/bin/php8.3');

// How many requests one tracker gets at the same time (default 10). Up to three trackers are
// asked at once, each within this limit. A higher number may get the account limited by the tracker.
//Config::write('curl.concurrency', 5);

// Address used to check the internet connection before trackers are polled.
// An empty string turns the check off.
//Config::write('connectivity.url', 'https://example.org/');
